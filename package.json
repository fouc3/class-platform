{
  "name": "class-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "班级学生成长平台 —— v9 的 TypeScript 复刻版（D1 存储，CF Worker 标准）",
  "scripts": {
    "dev": "WRANGLER_REGISTRY_PATH=.wrangler-local/registry WRANGLER_LOG_PATH=.wrangler-local/logs WRANGLER_SEND_METRICS=false wrangler dev --local --port 8787",
    "migrate": "node src/scripts/migrate-v9-d1.ts",
    "db:init": "npm run migrate && wrangler d1 execute class-platform-db --local --file=d1.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
